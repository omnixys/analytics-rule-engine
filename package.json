{
  "name": "@omnixys/analytics-rule-engine",
  "version": "1.0.0",
  "description": "Deterministic JSON AST evaluator for the Omnixys Analytics & Insights Platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  }
}
